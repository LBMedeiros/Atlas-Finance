# Segredo usado para assinar os tokens de login (mínimo 32 caracteres).
# `npm run setup` (na raiz) cria o .env e gera um valor aleatório automaticamente.
# Gerar manualmente: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Porta da API
PORT=3000

# Endereço(s) do frontend autorizados a chamar a API (separe vários com vírgula)
CORS_ORIGIN=http://localhost:5173

# Caminho do arquivo do banco SQLite (opcional; padrão: backend/data/atlas.db)
# DB_PATH=
